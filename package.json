{
	"name": "gadvat-rewrite",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "npm run build-data",
		"dev": "vite dev",
		"prebuild": "npm run build-data",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run build-data",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"build-data": "node scripts/build-data.js",
		"commons:sync": "node scripts/commons-sync.js"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/instrument-sans": "^5.3.0",
		"@fontsource/mukta": "^5.3.0",
		"@fontsource/tiro-devanagari-marathi": "^5.3.0",
		"d3-ease": "^3.0.1",
		"d3-selection": "^3.0.0",
		"d3-transition": "^3.0.1",
		"d3-zoom": "^3.0.0",
		"gray-matter": "^4.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/d3-ease": "^3.0.2",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-transition": "^3.0.9",
		"@types/d3-zoom": "^3.0.9",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
